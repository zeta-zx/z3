{
	"name": "z3",
	"version": "0.1.0",
	"type": "module",
	"main": "dist-electron/main.js",
	"author": "uukelele <uukelele@proton.me>",
	"description": "z3 is an Electron app that allows you to listen to your playlist and **own** your music.",
	"build": {
		"asarUnpack": [
			"**/node_modules/ffmpeg-static/*"
		],
		"appId": "com.zeta.z3",
		"productName": "Zeta",
		"directories": {
			"output": "dist-release"
		},
		"files": [
			"dist-electron/**/*",
			"build/**/*",
			"package.json"
		],
		"win": {
			"target": [
				"nsis",
				"portable",
				"msi"
			],
			"icon": "static/icons/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowElevation": true,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"runAfterFinish": true,
			"artifactName": "${productName}-Setup-${version}.${ext}"
		},
		"mac": {
			"target": "dmg",
			"icon": "static/icons/icon.icns",
			"category": "public.app-category.entertainment"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"icon": "static/icons",
			"category": "AudioVideo"
		},
		"deb": {
			"depends": [
				"gconf2",
				"libappindicator1"
			],
			"priority": "optional"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "zeta-zx",
				"repo": "z3"
			}
		],
		"artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dist": "npm run build && electron-builder"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tauri-apps/cli": "^2.10.1",
		"@types/fluent-ffmpeg": "^2.1.28",
		"electron": "^42.1.0",
		"electron-builder": "^26.8.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-electron": "^0.29.1"
	},
	"dependencies": {
		"@ephaptic/client": "^0.3.0",
		"@ephaptic/server": "^0.1.0",
		"@saavn-labs/sdk": "^0.1.5",
		"@xhayper/discord-rpc": "^1.3.4",
		"electron-updater": "^6.8.3",
		"ffmpeg-static": "^5.3.0",
		"fluent-ffmpeg": "^2.1.3",
		"lucide-svelte": "^0.577.0",
		"node-id3": "^0.2.9",
		"youtubei.js": "^17.0.1"
	}
}
